# runtime-created dirs/files land here rather than under userData.
/assets/
/backups/
/recovery/
/metadata.json
/.worshipsync-lock.json
storage-config.json

# User uploaded assets
resources/user/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Electron packager output
packages/
release/

# Test fixtures (vitest — deliberately not under the OS temp dir, see test/fixtures.ts)
.vitest-tmp/

# Environment / secrets
.env
.env.*